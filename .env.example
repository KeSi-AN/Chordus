# Copy to `.env` in the repo root. Every variable is optional for local use;
# the defaults below are what the app uses when a variable is unset.

# --- Database (libSQL) ---
# Local SQLite file (relative paths resolve against the repo root).
# Hosted later: a Turso URL such as libsql://<db>-<org>.turso.io
DATABASE_URL=file:./data/app.db
# Turso auth token (hosted only). Leave empty locally.
DATABASE_AUTH_TOKEN=

# --- File storage ---
# Root folder for local storage; uploaded audio goes to $DATA_DIR/audio.
DATA_DIR=./data
# Maximum audio upload size in megabytes.
MAX_UPLOAD_MB=100

# --- Dev server ---
# Extra hostnames allowed to open the dev server (comma-separated). LAN ranges 192.168.*.*,
# 10.*.*.* and *.local are already allowed so you can open the app from a phone.
ALLOWED_DEV_ORIGINS=

# --- Analyzer (services/analyzer) ---
# Where the web app checks the analyzer's health. Jobs themselves go through the database.
ANALYZER_URL=http://127.0.0.1:8000
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=8000
# Seconds between job-queue polls.
ANALYZER_POLL_SECONDS=2
# Longest audio (in minutes) the analyzer accepts. Longer uploads and videos (mixes, albums,
# live streams) are refused instead of tying up the worker.
ANALYZER_MAX_MINUTES=20
# Torch device for Demucs: auto | cpu | cuda
ANALYZER_DEVICE=auto
DEMUCS_MODEL=htdemucs
# Set to 0 to skip Demucs: much faster, but chords come from the full mix (less accurate)
# and there is no melody range or lyrics.
ANALYZER_MELODY=1
# Lyrics transcription from the vocal stem. Set to 0 for chords-only sheets.
ANALYZER_LYRICS=1
# Whisper model: tiny | base | small | medium (medium needs about 4 GB of GPU memory).
WHISPER_MODEL=medium
