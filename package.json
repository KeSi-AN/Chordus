{
  "name": "chordus",
  "private": true,
  "version": "0.0.0",
  "description": "Personal chord sheet + pitch shift + voice-fit app",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @chordus/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @chordus/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @chordus/web db:generate",
    "db:migrate": "pnpm --filter @chordus/web db:migrate",
    "db:seed": "pnpm --filter @chordus/web db:seed",
    "db:reset": "pnpm --filter @chordus/web db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
